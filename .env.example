# ---- Backend (backend/.env) ----

# SQLite for local dev. For production, point this at a Postgres URL, e.g.
# postgresql+psycopg2://user:password@host:5432/splitsmart
DATABASE_URL=sqlite:///./splitsmart.db

# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
# Never commit a real secret. This value is used to sign JWT access/refresh tokens.
SECRET_KEY=change-this-to-a-random-64-char-hex-string

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ---- Frontend (frontend/.env) ----
# Left as a relative path so Vite's dev proxy (see vite.config.ts) forwards
# it to the backend on the same origin -- this keeps the httpOnly refresh
# cookie same-site. Only point this at an absolute URL if you are not using
# the dev proxy (e.g. a separately hosted API in production).
VITE_API_BASE_URL=/api
